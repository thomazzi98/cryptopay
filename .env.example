# Copy to .env and fill in. .env is gitignored; .env.example must never contain a real secret.

# development | test | production
NODE_ENV=development

HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL connection string. With the bundled compose file this is the value below.
DATABASE_URL=postgresql://cryptopay:cryptopay@localhost:5432/cryptopay

# Peppers the API key digests, so a copy of the database alone does not permit offline
# verification of a stolen key list. At least 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=replace-me-with-at-least-thirty-two-characters

# Explicit host:port destinations that may be reached by a webhook despite resolving to a private
# address, so the bundled demo receiver works during development.
#
# Two independent conditions must both hold before an entry applies: the deployment must not be
# production, and the payment must be in the test environment. Setting this while NODE_ENV=production
# is a fatal startup error rather than a warning.
CALLBACK_PRIVATE_DESTINATION_ALLOWLIST=

# Wraps the data key that encrypts each environment's master wallet seed, base64 for 32 bytes.
# Whoever can read this can unwrap every unswept deposit key: see docs/security.md.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WALLET_KEY_ENCRYPTION_KEY=

# Where the hosted checkout is served from. Payment responses build checkoutUrl on it.
PUBLIC_CHECKOUT_BASE_URL=http://localhost:3000/pay

# --- Chain scanning -----------------------------------------------------------------------------
# RPC endpoints per network, comma separated, in preference order. A network with no endpoint is not
# watched at all, and a payment cannot be created for it.
#
# Two or more endpoints per network are strongly recommended. The first serves reads; the rest second
# the finality opinion, and a payment that requires the finality tag will not complete without one of
# them agreeing. Do not use https://polygon-rpc.com: it answers 401 for anonymous callers.
POLYGON_AMOY_RPC_URLS=https://rpc-amoy.polygon.technology,https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_MAINNET_RPC_URLS=
LOCAL_ANVIL_RPC_URLS=

# The token a local development chain deployed. Every other network's asset list is a frozen
# constant; a development chain redeploys on every start, so its address cannot be one.
LOCAL_ANVIL_USDC_ADDRESS=

SCANNER_POLL_INTERVAL_MILLISECONDS=4000
SCANNER_LEASE_SECONDS=30

# --- Real testnet validation (optional, and only for the standalone validation script) ----------
# A funded Polygon Amoy key, used by the gated testnet workflow. The running service never loads it;
# a configuration test asserts that.
#
# It must be a key that has NEVER been funded on any mainnet, and this is not a formality. One
# secp256k1 key controls the same address on EVERY EVM chain at once, so a key with mainnet funds is
# a mainnet key whichever variable it is written into, and the name of that variable confines
# nothing. The first key configured for this repository turned out to hold real POL on Polygon
# mainnet and to have already signed six transactions there.
#
# Run `npm run check:testnet-key` before using one. It derives the address locally, asks four
# mainnets whether that address has ever been used, and exits non-zero if it has. The key itself is
# never sent anywhere.
AMOY_TESTNET_PRIVATE_KEY=
AMOY_TESTNET_RECEIVING_ADDRESS=
