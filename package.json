{
  "name": "cryptopay",
  "version": "0.1.0",
  "description": "Crypto payment processor with independent on-chain verification, built for Polygon",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Rafael Thomazzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomazzi98/cryptopay.git"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.1 <25.0.0",
    "npm": ">=11.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run --project shared --project api --project tools",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "tsc --build",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "node scripts/verify-docs.mjs --write",
    "docs:check": "node scripts/verify-docs.mjs",
    "test:integration": "vitest run --project api-integration",
    "test:live": "vitest run --project chain-live",
    "test:all": "vitest run",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:testnet-key": "node scripts/check-testnet-key.mjs",
    "demo": "node scripts/demo.mjs",
    "validate:amoy": "node scripts/validate-amoy.mjs",
    "test:e2e": "playwright test",
    "test:e2e:demo": "node scripts/demo.mjs --exec npx playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@nuintun/qrcode": "5.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "pg": "8.23.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "viem": "2.56.3",
    "vitest": "4.1.11"
  }
}
