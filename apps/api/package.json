{
  "name": "@cryptopay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.api.js",
    "dev": "node --env-file-if-exists=../../.env --watch src/main.api.ts",
    "start:chain-worker": "node --env-file-if-exists=../../.env dist/main.chain-worker.js",
    "dev:chain-worker": "node --env-file-if-exists=../../.env --watch src/main.chain-worker.ts",
    "db:migrate": "node --env-file-if-exists=../../.env dist/infrastructure/persistence/migrate-cli.js",
    "wallet:provision": "node --env-file-if-exists=../../.env dist/infrastructure/wallet/provision-seed-cli.js"
  },
  "dependencies": {
    "@cryptopay/shared": "0.1.0",
    "@noble/curves": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
