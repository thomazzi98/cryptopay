{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["husky"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tools/*.spec.mjs"],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs", "*.config.{js,ts}"]
    },
    "packages/shared": {
      "entry": ["src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "src/main.*.ts",
        "src/infrastructure/persistence/migrate-cli.ts",
        "src/infrastructure/persistence/bootstrap-cli.ts",
        "src/infrastructure/wallet/provision-seed-cli.ts",
        "src/**/*.spec.ts",
        "test/**/*.spec.ts",
        "test/setup/*.ts",
        "live/**/*.spec.ts",
        "local/**/*.spec.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "live/**/*.ts", "local/**/*.ts"]
    }
  }
}
